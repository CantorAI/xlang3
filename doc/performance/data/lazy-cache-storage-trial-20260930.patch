diff --git a/src/executor/xlang_vm/xlang_frame.h b/src/executor/xlang_vm/xlang_frame.h
index 4505960..e50d38e 100644
--- a/src/executor/xlang_vm/xlang_frame.h
+++ b/src/executor/xlang_vm/xlang_frame.h
@@ -156,0 +157,43 @@ struct XlangVMInstrCache : XlangVMInstrCacheCore {
+class XlangVMInstructionCaches {
+  std::vector<uint32_t> instruction_slots_;
+  std::vector<XlangVMInstrCache> entries_;
+
+  XLANG3_NOINLINE XlangVMInstrCache& materialize(size_t instruction) {
+    const auto slot = static_cast<uint32_t>(entries_.size());
+    entries_.emplace_back();
+    instruction_slots_[instruction] = slot;
+    return entries_.back();
+  }
+
+public:
+  XlangVMInstructionCaches() = default;
+  explicit XlangVMInstructionCaches(size_t instruction_count) { reset(instruction_count); }
+
+  void reset(size_t instruction_count) {
+    entries_.clear();
+    instruction_slots_.assign(instruction_count, UINT32_MAX);
+    // Cache entries are large (424 bytes on the measured Windows Release
+    // build), while most IR instructions never populate one. Construct only
+    // requested sites and pack them together instead of zeroing a full record
+    // for every opcode. Reserve the logical maximum without constructing it:
+    // fused handlers can hold two cache references, and monitoring callbacks
+    // can request another site. Those references must never move on insertion.
+    entries_.reserve(instruction_count);
+  }
+
+  size_t size() const { return instruction_slots_.size(); }
+  bool empty() const { return instruction_slots_.empty(); }
+
+  XLANG3_HOT_INLINE XlangVMInstrCache& operator[](size_t instruction) {
+    const uint32_t slot = instruction_slots_[instruction];
+    if (XLANG3_UNLIKELY(slot == UINT32_MAX)) return materialize(instruction);
+    return entries_[slot];
+  }
+
+  XlangVMInstrCache* find(size_t instruction) {
+    const uint32_t slot = instruction_slots_[instruction];
+    return slot == UINT32_MAX ? nullptr : &entries_[slot];
+  }
+
+};
+
