diff --git a/src/executor/xlang_vm/xlang_vm_inline_call.h b/src/executor/xlang_vm/xlang_vm_inline_call.h
--- a/src/executor/xlang_vm/xlang_vm_inline_call.h
+++ b/src/executor/xlang_vm/xlang_vm_inline_call.h
@@ -566,6 +566,15 @@ inline bool xlang_vm_try_two_argument_double_method(
         value_as_dict(instance_attribute_storage(*instance)) != nullptr) return false;
     const auto* klass = value_as_class(instance->klass);
     if (klass == nullptr || klass->has_getattribute_hook) return false;
+    // Omitting the method frame must not move an input's observable retirement
+    // context. Presence of any inherited __del__ takes the ordinary call path;
+    // weakref flags conservatively cover callbacks without a registry lookup.
+    if ((instance->header.gc_tracking_state.load(std::memory_order_relaxed) &
+         kObjectWeakrefFlagsMask) != 0) return false;
+    Value finalizer;
+    std::string finalizer_error;
+    if (object_lookup_class_attr(instance->klass, "__del__", finalizer, finalizer_error) ||
+        !finalizer_error.empty()) return false;
   }
   auto* guarded_instance = instances[guard_call.a];
   const auto& guard_name = method.names[guard_call.b];
