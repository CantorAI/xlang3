diff --git a/src/executor/xlang_vm/xlang_frame.h b/src/executor/xlang_vm/xlang_frame.h
index 4505960..983ef7c 100644
--- a/src/executor/xlang_vm/xlang_frame.h
+++ b/src/executor/xlang_vm/xlang_frame.h
@@ -26,0 +27 @@ limitations under the License.
+#include <cassert>
@@ -156,0 +158,48 @@ struct XlangVMInstrCache : XlangVMInstrCacheCore {
+class XlangVMInstructionCaches {
+  std::shared_ptr<const ir::FunctionExecutionMetadata> metadata_;
+  std::vector<XlangVMInstrCache> entries_;
+  std::unordered_map<size_t, XlangVMInstrCache> monitoring_entries_;
+
+public:
+  XlangVMInstructionCaches() = default;
+  void prepare(const std::shared_ptr<const ir::FunctionExecutionMetadata>& metadata) {
+    if (metadata_.get() == metadata.get()) return;
+    metadata_ = metadata;
+    entries_.clear();
+    monitoring_entries_.clear();
+    // Cache entries are large (424 bytes on the measured Windows Release
+    // build), while most IR instructions never populate one. Bind eligible
+    // sites to compact indices once, sharing the immutable map across frames.
+    // Normal execution then needs no lazy-allocation branch. This vector never
+    // grows within an activation: fused handlers hold multiple cache pointers.
+    // Monitoring-only sites use node storage whose references survive rehash.
+    entries_.resize(metadata_->cache_cleanup_instructions.size());
+  }
+
+  size_t size() const { return metadata_ ? metadata_->instruction_cache_slots.size() : 0; }
+  bool empty() const { return size() == 0; }
+
+  XLANG3_HOT_INLINE XlangVMInstrCache& operator[](size_t instruction) {
+    const uint32_t slot = metadata_->instruction_cache_slots[instruction];
+    // This shares the eligibility set used by cache cleanup. Every normal
+    // handler and fused guard must address a listed site; monitoring is the
+    // only caller allowed to materialize an otherwise uncached instruction.
+    assert(slot != UINT32_MAX);
+    return entries_[slot];
+  }
+
+  XlangVMInstrCache& for_monitoring(size_t instruction) {
+    const uint32_t slot = metadata_->instruction_cache_slots[instruction];
+    return slot != UINT32_MAX ? entries_[slot] : monitoring_entries_[instruction];
+  }
+
+  XlangVMInstrCache* find(size_t instruction) {
+    const uint32_t slot = metadata_->instruction_cache_slots[instruction];
+    if (slot != UINT32_MAX) return &entries_[slot];
+    if (monitoring_entries_.empty()) return nullptr;
+    auto found = monitoring_entries_.find(instruction);
+    return found == monitoring_entries_.end() ? nullptr : &found->second;
+  }
+
+};
+
