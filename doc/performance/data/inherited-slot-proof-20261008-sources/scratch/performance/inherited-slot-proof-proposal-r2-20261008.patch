+  instance_slot_at(instance, index) = Value::int64(103);
+  expect_true(result, xlang_vm_load_attr_cached(receiver, "x", cache, found, error) &&
+      cache.kind == AttrSiteKind::InstanceSlot && found.as.i64 == 103,
